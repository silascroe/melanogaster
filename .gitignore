.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local/editor files and secrets
.vscode/
.idea/
.codex-remote-attachments/
.superpowers/
*.log
.env
.env.*
!.env.example

# The official release files are intentionally kept locally, not committed.
# The placeholders and source manifest remain version-controlled.
data/original-data/*
data/working/*
!data/original-data/.gitkeep
!data/working/.gitkeep

# The duplicate clean backup is a local recovery copy, not repository history.
backups/

# Generated outputs are ignored by default. Compact, reproducible reports are
# explicitly unignored below; bulky per-timestep traces stay local.
outputs/*
!outputs/.gitkeep
!outputs/verification.json
!outputs/inspection/
!outputs/inspection/dataset_report.json
!outputs/baseline/
!outputs/baseline/selected_neurons.csv
!outputs/baseline/selected_edges.csv
!outputs/baseline/summary.json
!outputs/diagnostics/
!outputs/diagnostics/propagation_matrix.csv
!outputs/diagnostics/propagation_matrix.json
!outputs/diagnostics/synaptic_dynamics_matrix.csv
!outputs/diagnostics/synaptic_dynamics_matrix.json
!outputs/pathway-slice/
!outputs/pathway-slice/nodes.csv
!outputs/pathway-slice/edges.csv
!outputs/pathway-slice/edge_contributions.csv
!outputs/pathway-slice/runs.csv
!outputs/pathway-slice/summary.json
!outputs/circuit-story/
!outputs/circuit-story/story.md
!outputs/circuit-story/summary.json
!outputs/circuit-story/nodes.csv
!outputs/circuit-story/edges.csv
!outputs/circuit-story/runs.csv
!outputs/circuit-story/key_traces.csv
!outputs/circuit-story/key_edge_contributions.csv
!outputs/sensorimotor/
!outputs/sensorimotor/story.md
!outputs/sensorimotor/summary.json
!outputs/sensorimotor/nodes.csv
!outputs/sensorimotor/edges.csv
!outputs/sensorimotor/trajectory.csv

# Explicitly local-only simulation traces.
outputs/**/spikes.csv
outputs/**/voltages.csv
outputs/**/synaptic_dynamics_traces.csv

# Local Godot runtime and editor cache for the standalone 3D lab.
tools/godot/
arena3d/.godot/
arena3d/.import/
